{
  "schema_version": 1,
  "pilot_id": "reviewwrite-pilot-20",
  "timezone": "America/Los_Angeles",
  "total_rounds": 20,
  "review_rounds": [
    4,
    8,
    12,
    16,
    20
  ],
  "max_action_rounds_per_day": 2,
  "heartbeat_interval_hours": 4,
  "candidate_branch": "bot/pilot-20",
  "pull_request_mode": "one-draft-per-review-window",
  "version_policy": {
    "accepted_implementation": "patch",
    "review_only": "no-bump",
    "no_evidence": "no-bump",
    "stable_promotion": "review-gate-qualified"
  },
  "publication_policy": {
    "review_round_may_push_candidate_branch": true,
    "review_round_may_merge_main": true,
    "review_round_may_create_stable_release": true,
    "ordinary_round_may_publish": false,
    "direct_push_main": false,
    "require_pull_request": true,
    "require_green_ci": true,
    "require_all_release_gates": true,
    "require_reproducible_package": true,
    "require_post_release_verification": true
  },
  "change_limits": {
    "max_primary_problems_per_round": 1,
    "max_changed_tracked_files_per_round": 12,
    "max_new_runtime_dependencies": 0,
    "allow_license_change": false,
    "allow_safety_gate_weakening": false,
    "allow_runtime_network_access": false
  },
  "evidence_lanes": [
    "repository-bugs-and-regressions",
    "user-or-issue-examples",
    "competitor-primary-sources",
    "research-primary-sources"
  ]
}
